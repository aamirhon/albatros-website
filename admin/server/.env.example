# Copy this file to .env and adjust. .env is gitignored and must never be committed.

# Port the admin backend listens on.
PORT=4000

# Origin of the admin UI (Vite dev server) allowed via CORS.
CLIENT_ORIGIN=http://localhost:5173

# Absolute path to the albatros-website repo root (the folder that contains
# src/data/catalog.json and public/images). Defaults to three levels up from
# admin/server/src, which is correct when admin/ lives inside the repo.
# SITE_ROOT=C:\Users\User\OneDrive\Desktop\Said\Work\albatros-website

# JWT signing secret (REQUIRED, at least 32 chars). The server refuses to start
# without it. Anyone who knows it can log in as any admin without a password,
# so never share it; changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid.
JWT_EXPIRES_IN=12h

# Allow-list of admin emails (comma-separated). When set, ONLY these accounts
# can log in or keep a session, even if other entries appear in users.json.
# Strongly recommended in production.
# ADMIN_EMAILS=admin@albatros.uz

# Which proxies may set X-Forwarded-For (Express "trust proxy"). "loopback" fits
# nginx/caddy on the same machine; used so login rate limiting sees real IPs.
# TRUST_PROXY=loopback

# Secure flag on the session cookie: "auto" (default) = set when the request
# came over HTTPS (directly or via X-Forwarded-Proto). "true"/"false" force it.
# COOKIE_SECURE=auto

# OPTIONAL: Anthropic API key for the "Черновик UZ" auto-translate button.
# Without it the panel works normally, you just type Uzbek by hand.
# Get a key at https://platform.claude.com (the owner already has one from alba-bot).
# ANTHROPIC_API_KEY=sk-ant-...

# PRODUCTION ONLY. When "true", every successful commit is also pushed to
# origin/DEPLOY_BRANCH — i.e. every save in the panel goes live automatically.
# Leave unset/false for local development, where commits stay local as before.
AUTO_PUSH=false

# Branch that AUTO_PUSH pushes to. Must match whatever branch the deploy hook
# on the main site's host is watching.
DEPLOY_BRANCH=deploy-website

# NOTE: pushing from the server requires a git remote "origin" configured
# with a Personal Access Token (fine-grained, scoped to only this repo,
# permission Contents: Read and write). Do NOT put the token in this .env
# file. Instead, after deploying, run this once directly on the server:
#   git remote set-url origin https://<TOKEN>@github.com/aamirhon/albatros-website.git
